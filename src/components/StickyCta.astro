---
const mailHref =
  'mailto:sales@desertrich.com?subject=Domain%20Inquiry%3A%20BWax.me%20%E2%80%94%20%2450%2C000';
const offerHref =
  'mailto:sales@desertrich.com?subject=Offer%20for%20BWax.me&body=Hi%2C%0A%0AI%20would%20like%20to%20make%20an%20offer%20for%20BWax.me.%0A%0AOffer%3A%20%24%0AName%3A%0AEscrow%20or%20registrar%20of%20choice%3A%0A%0AThanks.';
---

<div
  class="fixed inset-x-0 bottom-0 z-50 border-t border-white/10 bg-ink-950/95 backdrop-blur-md sm:hidden"
  role="region"
  aria-label="Purchase BWax.me"
>
  <div class="flex items-center gap-2 px-3 py-2.5">
    <div class="min-w-0 flex-1 leading-tight">
      <p class="truncate font-display text-xl font-semibold text-gold-300">$50,000</p>
      <p class="truncate text-[10px] uppercase tracking-widestx text-ivory-200/60">BWax.me for sale</p>
    </div>
    <a href={offerHref} class="min-h-12 shrink-0 rounded-full border border-white/30 px-4 text-xs font-medium text-white">
      Offer
    </a>
    <a href={mailHref} class="min-h-12 shrink-0 rounded-full bg-gold-400 px-4 text-xs font-semibold text-ink-950">
      Email to buy
    </a>
  </div>
</div>
